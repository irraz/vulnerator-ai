# =============================================================================
# .gitignore — keep OUT of the public repo every secret, credential or engagement
# data. The *.example files ARE versioned (they are templates).
# =============================================================================

# --- Secrets and local environment (NEVER version) ---
.env
.env.*
!.env.example
*.local

# --- Scope-guard: the real scope of an engagement is NOT versioned (the template is) ---
scope.json

# --- AWS credentials that could end up in the working tree ---
.aws/
credentials
*.pem
*.key
!**/profile/env.example

# --- Engagement data: artifacts, findings, reports, captures ---
# Pentest evidence and output must not end up in the repo.
artifacts/
/artifacts/
*.jsonl
findings-*.json
report-*.md
*.pcap
# Exception: REDACTED sample versioned on purpose as documentation (docs/).
# The IP is the RFC 5737 documentation IP (192.0.2.1) and the serial number/hostname are redacted.
!docs/example-findings.jsonl

# --- Hermes profile state generated in tests ---
profiles/
state.db
state.db-*

# --- macOS noise ---
.DS_Store

# --- Python / pytest artifacts (build noise, not source) ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
# uv lockfile: local environment noise; the dev pins live in requirements-dev.txt.
uv.lock

# --- Local work notes (do not version) ---
# Internal feature and planning backlog; it lives in the repo but outside git.
backlog.md
# Internal agent/workflow artifacts (reports, verification notes): not product.
.agents/
.worktrees/

# --- Benchmark outputs (generated; the directory itself is versioned) ---
scripts/benchmark/results/*
!scripts/benchmark/results/.gitkeep

# --- Labs: executable exploits are NEVER versioned (SECURITY) ---
# The labs document vulnerabilities, but functional exploits must not be in the repo.
labs/**/exploits/

# --- Vulnerable lab (testing environment with Workers) ---
vulnerable-lab/
