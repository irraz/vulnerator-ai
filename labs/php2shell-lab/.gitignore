# Labs php2shell — Ignore generated and temporary files

# Session files generated by the lab
webroot/sessions/
sessions/

# Container logs
*.log

# Configuration backups
*.bak
*.backup

# Temporary testing files
test_*.py
test_*.sh
*.pyc
__pycache__/

# Sensitive data (if custom payloads/scripts are added)
exploits/
payloads/
*.secret

# Docker compose override (if customized locally)
docker-compose.override.yml

# Vulnerator artifacts (if run from the lab)
.agents/
findings.jsonl
pentest-report.*
